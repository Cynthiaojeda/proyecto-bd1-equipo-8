/* ==========================================
   FACTURA / COMPROBANTE DE VENTA
   ========================================== */
SELECT
    C.codigo_compra AS Numero_Comprobante,
    C.fecha AS Fecha_Compra,
    C.tipo_cliente AS Tipo_Cliente,

    CL.dni AS Numero_Cliente,
    P.dni AS DNI_Cliente,
    P.nombre AS Nombre_Cliente,
    P.apellido AS Apellido_Cliente,
    P.telefono AS Telefono_Cliente,
    CL.direccion AS Direccion_Cliente,
    CL.ciudad AS Ciudad_Cliente,

    PR.codigo_producto AS Codigo_Producto,
    PR.nombre AS Producto,
    DC.cantidad AS Cantidad,
    DC.precio_unitario AS Precio_Unitario,

    CAST(DC.cantidad * DC.precio_unitario AS DECIMAL(12,2))
        AS Subtotal_Renglon,

    CAST(
        SUM(DC.cantidad * DC.precio_unitario)
        OVER (PARTITION BY C.codigo_compra)
        AS DECIMAL(12,2)
    ) AS Total_Calculado_Detalle,

    C.monto_total AS Total_Registrado

FROM Compra C
INNER JOIN Cliente CL
    ON C.dni_cliente = CL.dni
INNER JOIN Persona P
    ON CL.dni = P.dni
INNER JOIN Detalle_Compra DC
    ON C.codigo_compra = DC.codigo_compra
INNER JOIN Producto PR
    ON DC.codigo_producto = PR.codigo_producto

ORDER BY C.codigo_compra, PR.codigo_producto;
GO

/* ==========================================
   VERIFICACION DE TOTALES
   ========================================== */
SELECT
    C.codigo_compra AS Numero_Comprobante,
    C.monto_total AS Total_Registrado,

    ISNULL(
        SUM(DC.cantidad * DC.precio_unitario), 0
    ) AS Total_Calculado_Detalle,

    C.monto_total -
    ISNULL(SUM(DC.cantidad * DC.precio_unitario), 0)
        AS Diferencia

FROM Compra C
LEFT JOIN Detalle_Compra DC
    ON C.codigo_compra = DC.codigo_compra

GROUP BY C.codigo_compra, C.monto_total

HAVING C.monto_total <>
    ISNULL(SUM(DC.cantidad * DC.precio_unitario), 0)

ORDER BY C.codigo_compra;
GO


/* ==========================================
CONSULTA DE NEGOCIO AVANZADA 
========================================== */
SELECT 
    P.dni AS DNI_Cliente,
    P.nombre + ' ' + P.apellido AS Nombre_Completo,
    CL.ciudad AS Ciudad,
    COUNT(DISTINCT M.id_mascota) AS Total_Mascotas,
    COUNT(DISTINCT C.nro_compra) AS Total_Compras,
    SUM(C.monto_total) AS Inversion_Total
FROM Persona P
INNER JOIN Cliente CL 
    ON P.dni = CL.dni
LEFT JOIN Mascota M 
    ON CL.nro_cliente = M.nro_cliente
LEFT JOIN Compra C 
    ON CL.nro_cliente = C.nro_cliente
GROUP BY P.dni, P.nombre, P.apellido, CL.ciudad
HAVING COUNT(DISTINCT M.id_mascota) >= 2
   AND SUM(C.monto_total) > (
       -- Subconsulta que calcula el promedio general de inversión por cliente
       SELECT AVG(Total_Cliente) 
       FROM (
           SELECT SUM(monto_total) AS Total_Cliente 
           FROM Compra 
           GROUP BY nro_cliente
       ) AS PromedioGeneral
   )
ORDER BY Inversion_Total DESC;


/* ==========================================
    REPORTE AGREGADO
     VENTAS POR CATEGORIA DE PRODUCTO
    (01/09/2026 AL 30/09/2026)
   ========================================== */
SELECT
    PR.tipo_producto AS Categoria,
    COUNT(DISTINCT C.nro_compra) AS Cantidad_Compras,
    SUM(DC.cantidad) AS Unidades_Vendidas,
    CAST(SUM(DC.cantidad * DC.precio_unitario) AS DECIMAL(12,2))
        AS Total_Vendido

FROM Compra C
INNER JOIN Detalle_Compra DC
    ON C.nro_compra = DC.nro_compra
INNER JOIN Producto PR
    ON DC.cod_producto = PR.cod_producto

WHERE C.fecha BETWEEN '2026-09-01' AND '2026-09-30'

GROUP BY PR.tipo_producto

ORDER BY Total_Vendido DESC;
GO


/* ==========================================
   PRUEBA: COMPARACION DE TOTALES
   ========================================== */
SELECT
    SUM(DC.cantidad * DC.precio_unitario) AS Total_Segun_Detalle
FROM Compra C
INNER JOIN Detalle_Compra DC
    ON C.nro_compra = DC.nro_compra
WHERE C.fecha BETWEEN '2026-09-01' AND '2026-09-30';

SELECT
    SUM(monto_total) AS Total_Segun_Compra
FROM Compra
WHERE fecha BETWEEN '2026-09-01' AND '2026-09-30';
