/*--- TABLA PERSONA ---*/
CREATE TABLE Persona (
	dni INT NOT NULL,
	nombre VARCHAR(50) NOT NULL,
	apellido VARCHAR(50) NOT NULL,
	telefono VARCHAR(20) NOT NULL,

	CONSTRAINT PK_Persona
	PRIMARY KEY (dni)
);
GO

/*--- TABLA PROFESIONAL ---*/
CREATE TABLE Profesional_Veterinario (
	dni INT NOT NULL,
	especialidad VARCHAR(50) NOT NULL,

	CONSTRAINT PK_profesional_veterinario
	PRIMARY KEY (dni),

	CONSTRAINT FK_profesional_veterinario_persona
	FOREIGN KEY (dni)
	REFERENCES Persona(dni)
);
GO

/*--- TABLA CLIENTE ---*/
CREATE TABLE Cliente (
	nro_cliente INT NOT NULL,
	dni INT NOT NULL,
	direccion VARCHAR(100) NOT NULL,
	ciudad VARCHAR(50) NOT NULL,

	CONSTRAINT PK_cliente
	PRIMARY KEY (nro_cliente),

	CONSTRAINT UQ_cliente_dni
	UNIQUE (dni),

	CONSTRAINT FK_cliente_persona
	FOREIGN KEY (dni)
	REFERENCES Persona(dni)
);
GO

/*--- TABLA MASCOTA ---*/
CREATE TABLE Mascota (
	id_mascota INT NOT NULL,
	nombre_mascota VARCHAR(50) NOT NULL,
	especie VARCHAR(30) NOT NULL,
	raza VARCHAR(50) NOT NULL,
	sexo VARCHAR(20) NOT NULL,
	edad INT NOT NULL,
	nro_cliente INT NOT NULL,

	CONSTRAINT PK_mascota
	PRIMARY KEY (id_mascota),

	CONSTRAINT FK_mascota_cliente
	FOREIGN KEY (nro_cliente)
	REFERENCES Cliente(nro_cliente),

	CONSTRAINT CK_mascota_edad
	CHECK (edad >= 0)
);
GO

/*--- TABLA TURNO ---*/
CREATE TABLE Turno (
	id_turno INT NOT NULL,
	fecha DATE NOT NULL,
	hora TIME NOT NULL,
	id_mascota INT NOT NULL,
	dni_profesional INT NOT NULL,

	CONSTRAINT PK_turno
	PRIMARY KEY (id_turno),

	CONSTRAINT FK_turno_mascota
	FOREIGN KEY (id_mascota)
	REFERENCES Mascota(id_mascota),

	CONSTRAINT FK_turno_profesional
	FOREIGN KEY (dni_profesional)
	REFERENCES Profesional_Veterinario(dni),

	/* Un veterinario no puede tener dos turnos en la misma fecha y hora */
	CONSTRAINT UQ_turno_profesional_fecha_hora
	UNIQUE (dni_profesional, fecha, hora)
);
GO

/*--- TABLA ATENCION ---*/
CREATE TABLE Atencion (
	id_atencion INT NOT NULL,
	id_turno INT NOT NULL,
	fecha_ingreso DATE NOT NULL,
	fecha_salida DATE NULL,
	tipo_atencion VARCHAR(50) NOT NULL,
	intervencion VARCHAR(200) NOT NULL,
	observaciones VARCHAR(300) NULL,

	CONSTRAINT PK_atencion
	PRIMARY KEY (id_atencion),

	/* Un turno puede generar como maximo una atencion */
	CONSTRAINT UQ_atencion_turno
	UNIQUE (id_turno),

	CONSTRAINT FK_atencion_turno
	FOREIGN KEY (id_turno)
	REFERENCES Turno(id_turno),

	CONSTRAINT CK_atencion_tipo
	CHECK (
		tipo_atencion IN
		('Vacunacion', 'Revision', 'Internacion', 'Tratamiento')
	),

	CONSTRAINT CK_atencion_fechas
	CHECK (
		fecha_salida IS NULL
		OR fecha_salida >= fecha_ingreso
	)
);
GO

/*--- TABLA PROVEEDOR ---*/
CREATE TABLE Proveedor (
	cuit CHAR(11) NOT NULL,
	razon_social VARCHAR(100) NOT NULL,
	telefono VARCHAR(20) NOT NULL,

	CONSTRAINT PK_proveedor
	PRIMARY KEY (cuit)
);
GO

/*--- TABLA PRODUCTO ---*/
CREATE TABLE Producto (
	cod_producto INT NOT NULL,
	nombre_producto VARCHAR(80) NOT NULL,
	descripcion VARCHAR(150) NOT NULL,
	tipo_producto VARCHAR(30) NOT NULL,
	stock INT NOT NULL,
	precio DECIMAL(10, 2) NOT NULL,

	CONSTRAINT PK_producto
	PRIMARY KEY (cod_producto),

	CONSTRAINT CK_producto_tipo
	CHECK (
		tipo_producto IN
		('Alimento', 'Accesorio', 'Transportadora')
	),

	CONSTRAINT CK_producto_stock
	CHECK (stock >= 0),

	CONSTRAINT CK_producto_precio
	CHECK (precio >= 0)
);
GO

/*--- TABLA ALIMENTO ---*/
CREATE TABLE Alimento (
	cod_producto INT NOT NULL,
	marca VARCHAR(50) NOT NULL,
	cantidad_kg DECIMAL(10,2) NOT NULL,

	CONSTRAINT PK_alimento
	PRIMARY KEY (cod_producto),

	CONSTRAINT FK_alimento_producto
	FOREIGN KEY (cod_producto)
	REFERENCES Producto(cod_producto),

	CONSTRAINT CK_alimento_cantidad
	CHECK (cantidad_kg >= 0)
);
GO

/*--- TABLA PROVEE ---*/
CREATE TABLE Provee (
	cuit CHAR(11) NOT NULL,
	cod_producto INT NOT NULL,

	CONSTRAINT PK_provee
	PRIMARY KEY (cuit, cod_producto),

	CONSTRAINT FK_provee_proveedor
	FOREIGN KEY (cuit)
	REFERENCES Proveedor(cuit),

	CONSTRAINT FK_provee_producto
	FOREIGN KEY (cod_producto)
	REFERENCES Producto(cod_producto)
);
GO

/*--- TABLA COMPRA ---*/
CREATE TABLE Compra (
	nro_compra INT NOT NULL,
	fecha DATE NOT NULL,
	tipo_cliente VARCHAR(20) NOT NULL,
	monto_total DECIMAL(10, 2) NOT NULL,
	nro_cliente INT NOT NULL,

	CONSTRAINT PK_compra
	PRIMARY KEY (nro_compra),

	CONSTRAINT FK_compra_cliente
	FOREIGN KEY (nro_cliente)
	REFERENCES Cliente(nro_cliente),

	CONSTRAINT CK_compra_tipo_cliente
	CHECK (
		tipo_cliente IN ('Mayorista', 'Minorista')
	),

	CONSTRAINT CK_compra_monto
	CHECK (monto_total >= 0)
);
GO

/*--- DETALLE COMPRA ---*/
CREATE TABLE Detalle_Compra (
	nro_compra INT NOT NULL,
	cod_producto INT NOT NULL,
	cantidad INT NOT NULL,
	precio_unitario DECIMAL(10,2) NOT NULL,

	CONSTRAINT PK_detalle_compra
	PRIMARY KEY (nro_compra, cod_producto),

	CONSTRAINT FK_detalle_compra_compra
	FOREIGN KEY (nro_compra)
	REFERENCES Compra(nro_compra),

	CONSTRAINT FK_detalle_compra_producto
	FOREIGN KEY (cod_producto)
	REFERENCES Producto(cod_producto),

	CONSTRAINT CK_detalle_compra_cantidad
	CHECK (cantidad > 0),

	CONSTRAINT CK_detalle_compra_precio
	CHECK (precio_unitario >= 0)
);
GO

