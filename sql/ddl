/*-------------------------------------------------*/
/* Proyecto integrador - Base de datos veterinaria */
/*-------------------------------------------------*/

CREATE DATABASE Veterinaria_Proyecto_Integrador_Grupo8;
GO

USE Veterinaria_Proyecto_Integrador_Grupo8;
GO

---------------------------------------------------------------------------------
-- personas y roles (persona, profesional, cliente)---
---------------------------------------------------------------------------------

CREATE TABLE Persona (
    dni INT NOT NULL,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    telefono VARCHAR(20) NOT NULL,

    CONSTRAINT PK_Persona
        PRIMARY KEY (dni)
);
GO

CREATE TABLE Profesional (
    dni INT NOT NULL,
    especialidad VARCHAR(50) NOT NULL,

    CONSTRAINT PK_Profesional
        PRIMARY KEY (dni),

    CONSTRAINT FK_Profesional_Persona
        FOREIGN KEY (dni)
        REFERENCES Persona(dni)
);
GO

CREATE TABLE Cliente (
    dni INT NOT NULL,
    direccion VARCHAR(100) NOT NULL,
    ciudad VARCHAR(50) NOT NULL,

    CONSTRAINT PK_Cliente
        PRIMARY KEY (dni),

    CONSTRAINT FK_Cliente_Persona
        FOREIGN KEY (dni)
        REFERENCES Persona(dni)
);
GO

----------------------------------------
-- Turnos y mascotas (atencion, mascota, turno) --
----------------------------------------

CREATE TABLE Atencion (
    id_atencion INT NOT NULL,
    fecha_ingreso DATE NOT NULL,
    fecha_salida DATE NULL,
    tipo_atencion VARCHAR(30) NOT NULL,
    intervencion VARCHAR(100) NULL,
    observaciones VARCHAR(200) NULL,

    CONSTRAINT PK_Atencion
        PRIMARY KEY (id_atencion),

    CONSTRAINT CK_Atencion_Tipo
        CHECK (
            tipo_atencion IN
            ('Vacunacion', 'Revision', 'Internacion')
        ),

    CONSTRAINT CK_Atencion_Fecha
        CHECK (
            fecha_salida IS NULL
            OR fecha_salida >= fecha_ingreso
        )
);
GO

CREATE TABLE Mascota (
    id_mascota INT NOT NULL,
    nombre VARCHAR(50) NOT NULL,
    especie VARCHAR(30) NOT NULL,
    raza VARCHAR(50) NOT NULL,
    sexo VARCHAR(20) NOT NULL,
    edad INT NOT NULL,
    dni_cliente INT NOT NULL,
    id_atencion INT NOT NULL,

    CONSTRAINT PK_Mascota
        PRIMARY KEY (id_mascota),

    CONSTRAINT FK_Mascota_Cliente
        FOREIGN KEY (dni_cliente)
        REFERENCES Cliente(dni),

    CONSTRAINT FK_Mascota_Atencion
        FOREIGN KEY (id_atencion)
        REFERENCES Atencion(id_atencion),

    CONSTRAINT CK_Mascota_Edad
        CHECK (edad >= 0),

    CONSTRAINT CK_Mascota_Sexo
        CHECK (sexo IN ('Macho', 'Hembra'))
);
GO

CREATE TABLE Turno (
    id_turno INT NOT NULL,
    fecha DATE NOT NULL,
    hora TIME NOT NULL,
    id_mascota INT NOT NULL,
    dni_profesional INT NOT NULL,

    CONSTRAINT PK_Turno
        PRIMARY KEY (id_turno),

    CONSTRAINT FK_Turno_Mascota
        FOREIGN KEY (id_mascota)
        REFERENCES Mascota(id_mascota),

    CONSTRAINT FK_Turno_Profesional
        FOREIGN KEY (dni_profesional)
        REFERENCES Profesional(dni),

/* Un profesional no puede tener dos turnos en la misma fecha y hora. */
    CONSTRAINT UQ_Turno_Profesional_Fecha_Hora
        UNIQUE (dni_profesional, fecha, hora)
);
GO

-----------------------------------------------------------------------
-- productos y proveedores (proveedor, producto, alimento, provee) --
-----------------------------------------------------------------------
CREATE TABLE Proveedor (
    cuit CHAR(11) NOT NULL,
    razon_social VARCHAR(100) NOT NULL,
    telefono VARCHAR(20) NOT NULL,

    CONSTRAINT PK_Proveedor
        PRIMARY KEY (cuit),

    CONSTRAINT UQ_Proveedor_Razon_Social
        UNIQUE (razon_social)
);
GO

CREATE TABLE Producto (
    codigo_producto INT NOT NULL,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(100) NOT NULL,
    stock INT NOT NULL,
    precio DECIMAL(10,2) NOT NULL,

    CONSTRAINT PK_Producto
        PRIMARY KEY (codigo_producto),

    CONSTRAINT UQ_Producto_Nombre
        UNIQUE (nombre),

    CONSTRAINT CK_Producto_Stock
        CHECK (stock >= 0),

    CONSTRAINT CK_Producto_Precio
        CHECK (precio >= 0)
);
GO

CREATE TABLE Alimento (
    codigo_producto INT NOT NULL,
    marca VARCHAR(50) NOT NULL,
    cantidad_kg DECIMAL(10,2) NOT NULL,

    CONSTRAINT PK_Alimento
        PRIMARY KEY (codigo_producto),

    CONSTRAINT FK_Alimento_Producto
        FOREIGN KEY (codigo_producto)
        REFERENCES Producto(codigo_producto),

    CONSTRAINT CK_Alimento_Cantidad
        CHECK (cantidad_kg >= 0)
);
GO

CREATE TABLE Provee (
    cuit CHAR(11) NOT NULL,
    codigo_producto INT NOT NULL,

    CONSTRAINT PK_Provee
        PRIMARY KEY (cuit, codigo_producto),

    CONSTRAINT FK_Provee_Proveedor
        FOREIGN KEY (cuit)
        REFERENCES Proveedor(cuit),

    CONSTRAINT FK_Provee_Producto
        FOREIGN KEY (codigo_producto)
        REFERENCES Producto(codigo_producto)
);
GO

------------------------------------------------------------------------------
-- compras y facturas (compra, detalle_compra) --
------------------------------------------------------------------------------
CREATE TABLE Compra (
    codigo_compra INT NOT NULL,
    fecha DATE NOT NULL,
    tipo_cliente VARCHAR(20) NOT NULL,
    monto_total DECIMAL(10,2) NOT NULL,
    dni_cliente INT NOT NULL,

    CONSTRAINT PK_Compra
        PRIMARY KEY (codigo_compra),

    CONSTRAINT FK_Compra_Cliente
        FOREIGN KEY (dni_cliente)
        REFERENCES Cliente(dni),

    CONSTRAINT CK_Compra_TipoCliente
        CHECK (
            tipo_cliente IN ('Mayorista', 'Minorista')
        ),

    CONSTRAINT CK_Compra_Monto
        CHECK (monto_total >= 0)
);
GO

CREATE TABLE Detalle_Compra (
    codigo_compra INT NOT NULL,
    codigo_producto INT NOT NULL,
    cantidad INT NOT NULL,
    precio_unitario DECIMAL(10,2) NOT NULL,

    CONSTRAINT PK_Detalle_Compra
        PRIMARY KEY (codigo_compra, codigo_producto),

    CONSTRAINT FK_Detalle_Compra
        FOREIGN KEY (codigo_compra)
        REFERENCES Compra(codigo_compra),

    CONSTRAINT FK_Detalle_Producto
        FOREIGN KEY (codigo_producto)
        REFERENCES Producto(codigo_producto),

    CONSTRAINT CK_Detalle_Cantidad
        CHECK (cantidad > 0),

    CONSTRAINT CK_Detalle_Precio
        CHECK (precio_unitario >= 0)
);
GO
